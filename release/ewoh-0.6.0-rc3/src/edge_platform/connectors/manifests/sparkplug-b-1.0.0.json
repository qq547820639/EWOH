{
  "id": "sparkplug-b",
  "version": "1.0.0",
  "runtime": "edge-python",
  "protocol": "mqtt-sparkplugb",
  "inputProfile": "eclipse-sparkplug-3.0",
  "outputEvents": [
    "DeviceBirth",
    "DeviceStateChanged",
    "TelemetryObserved",
    "SessionStateChanged"
  ],
  "configSchema": {
    "required": [
      "brokerUrl",
      "groupId",
      "clientId"
    ],
    "properties": {
      "brokerUrl": {"type": "string"},
      "groupId": {"type": "string"},
      "clientId": {"type": "string"}
    }
  },
  "compatibility": {
    "core": ">=0.6.0-rc2 <1.0.0",
    "edgeRuntime": ">=1.0.0 <2.0.0"
  },
  "permissions": {
    "network": ["mqtt://factory-lan:*"],
    "api": ["POST /api/ingestion/*"]
  },
  "tck": "tests/connector-tck.yaml",
  "sbom": "sbom.cdx.json",
  "rollback": "supported"
}
