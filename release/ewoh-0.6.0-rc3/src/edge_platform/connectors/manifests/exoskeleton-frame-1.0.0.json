{
  "id": "exoskeleton-frame",
  "version": "1.0.0",
  "runtime": "edge-python",
  "protocol": "exo-jsonl",
  "inputProfile": "ny-exo-a1",
  "outputEvents": [
    "DeviceBirth",
    "TelemetryObserved",
    "DeviceStateChanged"
  ],
  "configSchema": {
    "required": [
      "deviceId",
      "workerId",
      "sourceType"
    ],
    "properties": {
      "deviceId": {"type": "string"},
      "workerId": {"type": "string"},
      "sourceType": {"type": "string", "enum": ["real", "controlled_test", "simulated"]}
    }
  },
  "compatibility": {
    "core": ">=0.6.0-rc2 <1.0.0",
    "edgeRuntime": ">=1.0.0 <2.0.0"
  },
  "permissions": {
    "network": ["tcp://127.0.0.1:*"],
    "api": ["POST /api/ingestion/*"]
  },
  "tck": "tests/connector-tck.yaml",
  "sbom": "sbom.cdx.json",
  "rollback": "supported"
}
