{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///site-readiness/v1",
  "title": "EWOH Factory Site Readiness",
  "description": "Executable checklist for second/third factory site readiness before replication drills.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "factoryName", "siteContact", "items"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ewoh:///site-readiness/v1"
    },
    "factoryName": { "type": "string", "minLength": 1 },
    "siteContact": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "required", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "na"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
