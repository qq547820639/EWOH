{
  "id": "equipment-state",
  "version": "1.0.0",
  "runtime": "edge-python",
  "protocol": "mqtt",
  "inputProfile": "generic-machinery",
  "outputEvents": [
    "DeviceStateChanged",
    "TelemetryObserved"
  ],
  "configSchema": {
    "required": [
      "brokerUrl",
      "topicPrefix",
      "clientId"
    ],
    "properties": {
      "brokerUrl": {"type": "string"},
      "topicPrefix": {"type": "string"},
      "clientId": {"type": "string"}
    }
  },
  "compatibility": {
    "core": ">=0.6.0-rc2 <1.0.0",
    "edgeRuntime": ">=1.0.0 <2.0.0"
  },
  "permissions": {
    "network": ["mqtt://factory-lan:*"],
    "api": ["POST /api/ingestion/*"]
  },
  "tck": "tests/connector-tck.yaml",
  "sbom": "sbom.cdx.json",
  "rollback": "supported"
}
