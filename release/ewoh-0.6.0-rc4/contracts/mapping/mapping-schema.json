{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///mapping/v1",
  "title": "EWOH Mapping Definition",
  "description": "Versioned mapping DSL for connector and scenario pack data contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingId",
    "name",
    "version",
    "source",
    "target",
    "rules"
  ],
  "properties": {
    "mappingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "$ref": "#/$defs/endpoint"
    },
    "target": {
      "$ref": "#/$defs/endpoint"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "schemaRef"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
