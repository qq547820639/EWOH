{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///workflow/v1",
  "title": "EWOH Workflow Definition",
  "description": "Versioned workflow contract for scenario pack execution flows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "version",
    "start",
    "steps"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "start": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "action",
        "allowedRoles",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
