# EWOH standalone cloud runtime
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://ewoh.example.com
API_PREFIX=/api
CORS_ORIGINS=https://ewoh.example.com
BODY_LIMIT=1mb

# Database (non-owner ewoh_api role on managed PostgreSQL 17)
DATABASE_URL=
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_SCHEMA=public

# Redis (managed Redis 7)
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d

# File storage: local disk fallback
UPLOAD_DIR=./data/uploads
EWOH_DB_STATEMENT_TIMEOUT_MS=30000
EWOH_DB_SLOW_THRESHOLD_MS=1000
MAX_UPLOAD_BYTES=20971520
# Comma-separated allowlist; leave empty to use the built-in safe defaults.
UPLOAD_ALLOWED_MIME_TYPES=

# Optional S3-compatible object storage (MinIO, R2, S3, etc.)
# When endpoint and bucket are both set, the API uses S3 instead of local disk.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PREFIX=files
# Set true for multi-replica deployments so startup fails without object storage.
REQUIRE_OBJECT_STORAGE=false

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
TRACE_ENDPOINT=
EWOH_FACTORY_ID=
EWOH_FACTORY_NAME=
EWOH_FACTORY_UPGRADE_RING=pilot
EWOH_RELEASE_VERSION=0.6.0-rc3
EWOH_REGION=

# Work Orchestration Control Plane
# Repository artifacts are authoritative. Writes are disabled by default.
EWOH_WORK_ARTIFACTS_DIR=/app/.codex/artifacts
EWOH_WORK_TOOLS_DIR=/app/tools
EWOH_WORK_WRITABLE=false
