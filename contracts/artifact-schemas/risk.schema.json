{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ewoh:///artifact/risk/v1",
  "title": "EWOH Risk Register",
  "description": "Parsed risk entries from .codex/artifacts/risk-register.md. Object containing a risks array.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risks"
  ],
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "mitigation",
          "escalation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-\\d{3}$"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "mitigated",
              "in_review"
            ]
          },
          "mitigation": {
            "type": "string"
          },
          "escalation": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "resolutionEvidence": {
            "type": "string"
          }
        }
      }
    }
  }
}