{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ewoh:///decision/decision/v1",
  "title": "EWOH Canonical Decision Record",
  "description": "Canonical Decision Model（ADR-047 / §2/§3/§18）：跨运行时决策契约。kind/status/decisionAuthority 为封闭结构注册表（Decision Catalog v1）；riskLevel 复用 risk 契约 SEVERITY_LADDER（单一事实源，仲裁逐位比对）；判定事实完整：selected.reason 非空、selected 必在 options 中、human 决策或 approved/rejected 状态必带 approver、auditTrail 非空强制。",
  "type": "object",
  "additionalProperties": false,
  "schemaVersion": "1.0.0",
  "decisionKinds": [
    "task_assignment",
    "plan_approval",
    "agent_approval",
    "resource_reservation",
    "dispatch",
    "replan",
    "learning_proposal_activation",
    "policy_activation"
  ],
  "decisionStatuses": [
    "proposed",
    "approved",
    "rejected",
    "executed",
    "superseded"
  ],
  "decisionAuthorities": [
    "policy",
    "optimization",
    "rule_based",
    "human",
    "agent"
  ],
  "riskLevels": [
    "critical",
    "high",
    "medium",
    "low"
  ],
  "rules": {
    "decisionIdCanonicalPrefix": "decision:",
    "registriesClosed": true,
    "subjectCanonicalIdentity": true,
    "riskLadderSharedWithRiskContract": true,
    "selectedReasonRequired": true,
    "selectedMustBeAmongOptions": true,
    "approverRequiredWhenHumanDecided": true,
    "approverRequiredWhenDecided": true,
    "approverTimeNotBeforeDecision": true,
    "auditTrailRequired": true,
    "outcomeLinkOptional": true
  },
  "properties": {
    "decisionId": {
      "type": "string",
      "pattern": "^decision:[^\\s]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task_assignment",
        "plan_approval",
        "agent_approval",
        "resource_reservation",
        "dispatch",
        "replan",
        "learning_proposal_activation",
        "policy_activation"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "executed", "superseded"]
    },
    "decisionAuthority": {
      "type": "string",
      "enum": ["policy", "optimization", "rule_based", "human", "agent"]
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "riskLevel": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "decidedAt": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "solverVersion": {
      "type": "string",
      "minLength": 1
    },
    "snapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId"],
        "properties": {
          "optionId": { "type": "string", "minLength": 1 },
          "score": { "type": ["number", "null"] },
          "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "reason"],
      "properties": {
        "optionId": { "type": "string", "minLength": 1 },
        "reason": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "rejectedAlternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "rejectReasons"],
        "properties": {
          "optionId": { "type": "string", "minLength": 1 },
          "rejectReasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
        }
      }
    },
    "hardConstraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "weightsSnapshot": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "at"],
      "properties": {
        "actor": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$" },
        "at": { "type": "string" }
      }
    },
    "outcomeRef": {
      "type": "string",
      "minLength": 1
    },
    "auditTrail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "action", "at"],
        "properties": {
          "actor": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$" },
          "action": { "type": "string", "minLength": 1 },
          "at": { "type": "string" }
        }
      }
    }
  },
  "required": [
    "decisionId",
    "kind",
    "status",
    "decisionAuthority",
    "subject",
    "tenantId",
    "riskLevel",
    "requiresApproval",
    "decidedAt",
    "selected",
    "auditTrail"
  ]
}
