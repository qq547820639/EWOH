  "records": [
    {
      "name": "cartesian-valid",
      "record": { "coordinateType": "FACTORY_CARTESIAN", "x": 12.5, "y": -3.2, "z": 1.5, "yawDeg": 270 },
      "expectError": null
    },
    {
      "name": "cartesian-no-yaw-ok",
      "record": { "coordinateType": "FACTORY_CARTESIAN", "x": 0, "y": 0 },
      "expectError": null
