    {
      "name": "wgs84-valid",
      "record": { "coordinateType": "WGS84", "x": 31.2304, "y": 121.4737 },
      "expectError": null
    },
    {
      "name": "wgs84-lat-out-of-range",
      "record": { "coordinateType": "WGS84", "x": 91, "y": 121.4737 },
      "expectError": "bad_coordinate"
    },
    {
      "name": "wgs84-lng-out-of-range",
      "record": { "coordinateType": "WGS84", "x": 31.2, "y": -181 },
      "expectError": "bad_coordinate"
    },
    {
      "name": "unknown-with-coords-rejected",
      "record": { "coordinateType": "UNKNOWN", "x": 1, "y": 2 },
      "expectError": "bad_coordinate"
    },
    {
      "name": "unknown-bare-ok",
      "record": { "coordinateType": "UNKNOWN" },
      "expectError": null
    },
    {
      "name": "missing-type-rejected",
      "record": { "x": 1 },
      "expectError": "bad_coordinate"
    },
    {
      "name": "yaw-out-of-range",
      "record": { "coordinateType": "FACTORY_CARTESIAN", "x": 1, "y": 2, "yawDeg": 360 },
