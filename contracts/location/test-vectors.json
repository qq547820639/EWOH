    { "value": "workstation", "valid": true },
    { "value": "restricted_zone", "valid": true },
    { "value": "dock", "valid": true },
    { "value": "warehouse_location", "valid": true },
    { "value": "charging_area", "valid": true },
    { "value": "Workshop", "valid": false },
    { "value": "machine", "valid": false },
    { "value": "", "valid": false }
