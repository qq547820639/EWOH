{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///asset-catalog/v1",
  "title": "EWOH Asset Catalog",
  "description": "Versioned catalog of connector, scenario, template, mapping, and deploy assets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "generatedAt", "assets"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "ewoh:///asset-catalog/v1" },
    "catalogId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "packageType", "name", "version", "status"],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "packageType": {
          "type": "string",
          "enum": ["connector", "scenario", "template", "mapping", "deploy"]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string" },
        "manifest": { "type": "object" },
        "compatibility": { "type": "object" },
        "tck": { "type": "string" }
      }
    }
  }
}
