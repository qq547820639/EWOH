{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///connector-package/v1",
  "title": "EWOH Connector Package",
  "description": "Connector package manifest for catalog/ connector assets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "ewoh.io/v1alpha1" },
    "kind": { "type": "string", "const": "ConnectorPackage" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "protocol",
        "outputEvents",
        "configSchema",
        "secrets",
        "permissions",
        "compatibility",
        "tck"
      ],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "outputEvents": { "type": "array", "items": { "type": "string" } },
        "configSchema": { "type": "object" },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "object" },
        "compatibility": { "type": "object" },
        "tck": { "type": "string", "minLength": 1 },
        "sbom": { "type": "string" },
        "rollback": { "type": "string" }
      }
    }
  }
}
