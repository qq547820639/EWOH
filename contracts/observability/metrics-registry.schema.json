    "outcome",
    "connector_id",
    "connector_type",
    "table",
    "edge_id"
  ],
  "rules": {
    "registrationContract": "metricName 必须命中 metricRegistry（未注册 = violation 显式列出，绝不静默并入正常）",
    "typeContract": "metricType 必须与注册表声明一致（counter/gauge/histogram）",
    "labelContract": "labels 的键必须命中该指标注册表 labelKeys（未知键整体拒绝）",
    "valueContract": "value 为有限数值；counter 非负（拒绝负数/NaN/Infinity）",
    "histogramContract": "histogram 样本必须带 le 标签（Prometheus 兼容）",
    "violationContract": "导出面必须携带 registryViolations 显式列表——unknown 不当 normal（§33）"
  }
}