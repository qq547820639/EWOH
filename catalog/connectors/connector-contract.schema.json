{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ewoh:///connector-contract/v1",
  "title": "EWOH Unified Connector Quality Contract",
  "description": "Canonical quality-attribute contract shared by ERP/MRP/WMS catalog connector manifests. Declares the mandatory quality attributes every business connector must satisfy: canonical model, mapping template, cursor, idempotency, replay, compensation, dead-letter, rate-limit, data-quality and observability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonicalModel",
    "mappingTemplate",
    "cursor",
    "idempotency",
    "replay",
    "compensation",
    "deadLetter",
    "rateLimit",
    "dataQuality",
    "observability"
  ],
  "properties": {
    "canonicalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "entityType",
        "version"
      ],
      "properties": {
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "mappingTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateRef",
        "direction"
      ],
      "properties": {
        "templateRef": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "source-to-ewoh",
            "ewoh-to-source",
            "bidirectional"
          ]
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type",
        "mode"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "timestamp",
            "incrementing-id",
            "sequence",
            "offset"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "incremental",
            "full-snapshot",
            "both"
          ]
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyField",
        "ttlSeconds"
      ],
      "properties": {
        "keyField": {
          "type": "string",
          "minLength": 1
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "window",
        "mode"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "cursor-replay",
            "full-resync",
            "event-replay"
          ]
        }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "strategy"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "reverse-api",
            "correction-event",
            "manual",
            "none"
          ]
        }
      }
    },
    "deadLetter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "topic",
        "retryPolicy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxRetries",
            "backoffSeconds"
          ],
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 0
            },
            "backoffSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "requestsPerSecond",
        "burst"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requestsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "burst": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validateRequired",
        "schemaValidation",
        "rejectOnInvalid"
      ],
      "properties": {
        "validateRequired": {
          "type": "boolean"
        },
        "schemaValidation": {
          "type": "boolean"
        },
        "rejectOnInvalid": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "rule"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "healthEndpoint",
        "trace"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "healthEndpoint": {
          "type": "string",
          "minLength": 1
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "correlationIdField"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "correlationIdField": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}