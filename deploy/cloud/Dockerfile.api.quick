FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV EWOH_DEPLOY_TARGET=standalone
RUN mkdir -p /app/data/uploads && chown -R node:node /app
COPY --chown=node:node ewoh-spark-app/dist/ ./dist/
COPY --chown=node:node ewoh-spark-app/package.json ./
COPY --chown=node:node contracts/ ./contracts/
COPY --chown=node:node catalog/ ./catalog/
COPY --chown=node:node tools/ ./tools/
COPY --chown=node:node .codex/artifacts/ ./.codex/artifacts/
USER node
EXPOSE 3000
CMD ["node", "dist/server/main.js"]
