# EWOH 受控试点系统 - 环境变量样例
# 复制为 .env 并按现场环境填写；生产部署应通过密钥管理系统注入敏感值，不要提交 .env 到仓库。

# ---------- 服务监听 ----------
# 平台监听地址；试点环境默认仅监听内网回环/内网网卡，不直接对公网开放
EWOH_HOST=127.0.0.1
# 平台监听端口（与 docker-compose 中 ewoh-api 暴露端口一致）
EWOH_PORT=8765

# ---------- 数据库 ----------
# SQLite 后端时的数据库文件路径（开发/单机默认）；生产建议切换为 postgres
EWOH_DB_PATH=./data/ewoh.db
# 数据库后端类型：sqlite | postgres
EWOH_DB_BACKEND=sqlite
# postgres 后端时的连接串（仅 EWOH_DB_BACKEND=postgres 时生效；含敏感凭据，禁止提交真实值）
EWOH_DB_URL=postgresql://ewoh:CHANGE_ME@postgres:5432/ewoh

# ---------- 适配层 ----------
# 适配器端口到数据源类型的 JSON 映射；real=真机, controlled_test=受控测试源, simulated=仿真
EWOH_ADAPTER_PORTS={"9001":"real","9002":"controlled_test","9003":"simulated"}
# 设备离线判定阈值（秒）：超过该时长无心跳即标记为离线/失联安全态
EWOH_OFFLINE_AFTER_SEC=10
# 单条事件证据窗口长度（秒）：用于回溯采集前后高频遥测片段作为事件证据
EWOH_EVIDENCE_WINDOW_SEC=30
# 高频原始遥测保留天数（7-30 天，超期降采样或清除，详见 SECURITY.md）
EWOH_DATA_RETENTION_DAYS=14

# ---------- 日志 ----------
# 日志级别：DEBUG | INFO | WARNING | ERROR
EWOH_LOG_LEVEL=INFO

# ---------- 身份与权限 ----------
# 认证后端：customer=客户侧 SSO 对接, oidc=标准 OIDC, local=本地账号（仅开发/联调）
EWOH_AUTH_BACKEND=local
# OIDC 签发方 URL（EWOH_AUTH_BACKEND=oidc 时必填）
EWOH_OIDC_ISSUER=https://idp.example.com/realms/ewoh
# OIDC 客户端 ID
EWOH_OIDC_CLIENT_ID=ewoh-pilot
# JWT 签名密钥（本地/local 后端使用；生产应由 OIDC 签发，此值仅用于开发自签，禁止提交真实密钥）
EWOH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 会话超时时间（秒），超时后需重新认证或刷新令牌
EWOH_SESSION_TIMEOUT_SEC=3600
# 连续登录失败锁定阈值（次），达到后锁定账号一段时间
EWOH_LOGIN_FAIL_LOCK=5

# ---------- 数据导出权限 ----------
# 允许触发数据导出的角色，逗号分隔；与 delivery/04_安全合规/RBAC_matrix.csv 中的角色保持一致
EWOH_EXPORT_ALLOWED_ROLES=admin,safety_officer,data_analyst

# ---------- 智能调度（Solver 激活阶梯，唯一事实源） ----------
# 求解器激活阶梯：OFF（默认，仅 heuristic 生产，CP-SAT 不参与任何路径）/
# SHADOW（heuristic 生产 + CP-SAT 双跑 isShadow）/ CANARY（采样放量）/ PRODUCTION（需下方门禁）
# 解析优先级：本变量 > SchedulingPolicyConfig.cpSat.activation > OFF；非法值回退 OFF。
EWOH_SOLVER_ACTIVATION=OFF
# 生产门控：仅 '1' 允许 CP-SAT 进入 PRODUCTION 阶梯（与 feature-status.yaml
# cpSat.productionEnabled=true 对齐）；'0'（默认）fail-closed 回退 heuristic
# （fallbackReason=production_not_gated），CP-SAT 结果绝不成为生产方案。
EWOH_SOLVER_PRODUCTION_ENABLED=0

# ---------- 部署模式（多实例 replan 守卫 fail-closed） ----------
# 部署目标：production | standalone | development（缺省 development）。
# - production：跨实例 replan 守卫（PostgreSQL advisory lock）执行异常时 FAIL-CLOSED——
#   阻止 automatic replan（返回 blocked，不静默降级内存守卫），上报
#   scheduler_replan_guard_degraded_total 指标，且 /health/ready 返回 degraded reason
#   （checks.scheduler.replanGuard=degraded）。
# - 其余（缺省/development/standalone）：守卫异常时显式回退内存态风暴守卫（warn + 降级指标），
#   供单实例试点与测试使用。
# 注意：多实例生产部署必须显式设置 EWOH_DEPLOY_TARGET=production 以获得 fail-closed 保障。
EWOH_DEPLOY_TARGET=development

# ---------- TLS ----------
# TLS 证书与私钥路径（生产必填，由 nginx/edge-gateway 终结 TLS）
EWOH_TLS_CERT=./certs/ewoh.crt
EWOH_TLS_KEY=./certs/ewoh.key

# ---------- 视觉理解（演示模式默认后端：火山方舟 Ark） ----------
# 火山方舟 API Key（Bearer token）；未配置时 /api/vision/understand 返回明确错误，不伪造描述
EWOH_ARK_API_KEY=
# Ark OpenAPI 基础地址（默认北京地域）
EWOH_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视觉理解模型名
EWOH_ARK_MODEL=doubao-seed-2-1-pro-260628

# ---------- 边缘运行模式（P0-EDGE-002：Production 禁止 Silent Stub） ----------
# 运行模式：production（仅真实组件，装配失败非零退出）/ development（默认真实组件，
# 需 stub 必须显式 EWOH_ALLOW_STUB=1 或 --stub）/ simulation（显式 Stub/Simulator）。
# 注意：EWOH_DEPLOY_TARGET 是云侧部署目标，与本变量（边缘运行模式）相互独立。
EWOH_RUNTIME_MODE=development
# development 下显式允许回退 Stub（仅工程自测；production 下即使设置也 fail-closed）
EWOH_ALLOW_STUB=

# ---------- 边缘 CORS / 调度写权限 ----------
# 逗号分隔的显式 Origin allowlist；production 必须配置，未命中不回送 CORS 头
EWOH_CORS_ORIGINS=
# 边缘调度写权限：=1 允许 Edge 写调度数据（仅 development/test/simulation 模式生效；
# production + =1 → 启动即抛 SchedulingWriteProhibitedError fail-closed，正式调度写权限
# 唯一归 NestJS 控制面，避免 split-brain）
EWOH_EDGE_SCHEDULING_WRITE=

# ---------- CP-SAT Worker（可选组件，未部署 OR-Tools 时无效） ----------
# 以下仅当运行 src/edge_platform/scheduler/cpsat/worker.py 时生效（CP-SAT 为 OPTIONAL/
# EXPERIMENTAL，未生产启用；默认 OFF 时 CP-SAT 不参与任何路径）。
CPSAT_WORKER_MAX_CONCURRENCY=4
CPSAT_WORKER_QUEUE_WAIT_MS=1000
CPSAT_WORKER_MAX_SOLVE_MS=120000
CPSAT_WORKER_TIMEOUT_MARGIN_MS=5000
CPSAT_WORKER_MAX_TASKS=1000
CPSAT_WORKER_MAX_CANDIDATES=50000
CPSAT_WORKER_MAX_MEMORY_MB=2048

# ---------- 云侧服务监听（NestJS standalone） ----------
# main.ts 监听（非 standalone 入口）
SERVER_HOST=localhost
SERVER_PORT=3000
# standalone-main.ts 监听；PORT 与飞书侧车共用（standalone 3000 / 飞书侧车 3000，二选一部署时避免冲突）
HOST=0.0.0.0
PORT=3000
# 兼容别名：STANDALONE=1 等价 EWOH_DEPLOY_TARGET=standalone（legacy，新配置请用 EWOH_DEPLOY_TARGET）
STANDALONE=
# =1 时启用 legacy 入口（main.ts 的旧路由面）
EWOH_LEGACY_ENABLED=0

# ---------- 云侧数据库（NestJS standalone，PostgreSQL） ----------
# PostgreSQL 连接串（必填，缺失 → 启动失败）
DATABASE_URL=postgresql://ewoh:CHANGE_ME@127.0.0.1:5432/ewoh
# SUDA_DATABASE_URL 为 DATABASE_URL 的 deprecated 别名（兼容旧配置，新配置请用 DATABASE_URL）
SUDA_DATABASE_URL=
# 连接池上限与空闲回收（毫秒）
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
# SQL 慢查询阈值（毫秒）与语句超时（0=不设）
EWOH_DB_SLOW_THRESHOLD_MS=1000
EWOH_DB_STATEMENT_TIMEOUT_MS=0

# ---------- 云侧认证（NestJS standalone） ----------
# JWT 密钥（必填，需 ≥32 字符；不满足 → 启动失败）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 访问令牌与刷新令牌有效期
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d

# ---------- 云侧 Ingest（机器对机器鉴权，fail-closed） ----------
# Ingest API Key（production 必填：缺失 → 启动失败 + 请求 503）
INGEST_API_KEY=CHANGE_ME
# 仅开发/测试：=true 时跳过 Ingest 鉴权（生产严禁设置）
INGEST_INSECURE_DEV_MODE=false
# Ingest 请求归属的默认组织 ID（未从请求头取到时使用）
EWOH_INGEST_ORG_ID=

# ---------- 云侧集成 ----------
# 云侧访问边缘平台的地址（AI 控制器等转发用）
EDGE_PLATFORM_URL=http://127.0.0.1:8765
# CP-SAT worker 地址（当前未启用，heuristic 为 canonical；未部署 OR-Tools 时不可用）
CPSAT_WORKER_URL=http://127.0.0.1:8000

# ---------- 云侧 Web 框架 ----------
# 前端跨域白名单（逗号分隔；* 被禁止）
CORS_ORIGINS=
# 反向代理跳数（true 被禁止，用数字或 CIDR）
TRUST_PROXY=
# 请求体上限
BODY_LIMIT=1mb
# Redis 连接串（可选：限流/缓存；缺省则走内存实现）
REDIS_URL=
# =false 时关闭 /metrics 指标端点
METRICS_ENABLED=true
# 限流窗口（秒）与窗口内最大请求数
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
# =1 时启用调度 SSE 出站通知（需 DATABASE_URL 可达）
SCHEDULER_STREAM_NOTIFY=0

# ---------- 云侧可观测标签 / 资源属性 ----------
# Prometheus 资源标签与发布版本（默认值取自 version.json / 代码缺省）
EWOH_RELEASE_VERSION=0.6.0-rc4
EWOH_FACTORY_ID=unknown
EWOH_FACTORY_NAME=unknown
EWOH_FACTORY_UPGRADE_RING=unknown
EWOH_REGION=unknown

# ---------- 云侧契约/工作区 ----------
# 契约目录覆盖（事件目录等契约文件所在根目录；缺省用仓库 contracts/）
EWOH_CONTRACTS_DIR=
# Work 编排可写开关与工件/工具目录（缺省按代码推断仓库相对路径）
EWOH_WORK_WRITABLE=
EWOH_WORK_ARTIFACTS_DIR=
EWOH_WORK_TOOLS_DIR=

# ---------- 云侧文件上传 ----------
# 单文件上限（字节）与允许的 MIME 类型（逗号分隔；缺省按代码 DEFAULT_MAX_UPLOAD_BYTES）
MAX_UPLOAD_BYTES=
UPLOAD_ALLOWED_MIME_TYPES=
# 本地存储驱动落盘目录
UPLOAD_DIR=

# ---------- 对象存储（S3 兼容，可选；未配置回退本地存储） ----------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PREFIX=files
# =true 时强制要求对象存储已配置（缺失 → 启动失败）
REQUIRE_OBJECT_STORAGE=false

# ---------- 云侧 Simulator / 游戏化演示 ----------
# Simulator 默认不自动启动（fail-closed）：自动启动需显式 EWOH_SIMULATOR_ENABLED=1；
# =1 时禁用 Simulator 模块（显式 start() 亦被拒绝）；Simulator 数据归属组织 ID
EWOH_SIMULATOR_ENABLED=0
EWOH_SIMULATOR_DISABLED=1
EWOH_SIMULATOR_ORG_ID=
# 游戏化演示默认角色与显示名
EWOH_PLAYER_ROLE=shift_leader
EWOH_PLAYER_NAME=当前用户

# ---------- 飞书侧车（ewoh-feishu-app） ----------
# lark-cli 可执行文件路径与 CLI 并发/重试参数
LARK_CLI=lark-cli
FEISHU_CLI_MAX_RETRIES=3
FEISHU_CLI_MAX_QUEUE=200
# 飞书应用凭据：base token（自建应用）、API token、webhook 验签 token、
# 可选加密 key 与时间戳容忍（秒）
FEISHU_BASE_TOKEN=
FEISHU_API_TOKEN=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_TOLERANCE_SEC=300
# =true 时读请求也要求鉴权（默认仅写操作鉴权）
FEISHU_REQUIRE_AUTH_FOR_READS=false
# webhook CORS 白名单与请求体上限
FEISHU_CORS_ORIGINS=
FEISHU_BODY_LIMIT=1mb
# Simulator 默认关闭；production 开启需 FEISHU_SIMULATOR_ENABLED=true 且
# ALLOW_SIMULATOR_IN_PRODUCTION=true 双开关
FEISHU_SIMULATOR_ENABLED=false
ALLOW_SIMULATOR_IN_PRODUCTION=false
